# Set three independent, randomly generated values before starting Compose.
# No default application credentials are supplied.
SECRET_KEY=
ADMIN_PASSWORD=
POSTGRES_PASSWORD=

ADMIN_USERNAME=admin
POSTGRES_USER=garden
POSTGRES_DB=garden

# Used only when running the backend directly, outside Compose.
# Construct this locally with your own URL-encoded database credentials.
DATABASE_URL=

VITE_GARDENOS_API_BASE_URL=http://127.0.0.1:8000/api/v1
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000
